{
  "name": "keychanger-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "키 체인저 iOS·안드로이드 앱 (Capacitor)",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor '#c2410c' --splashBackgroundColor '#f6f4ef'",
    "add:android": "npm run web && npx cap add android",
    "add:ios": "npm run web && npx cap add ios",
    "sync": "npm run web && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
